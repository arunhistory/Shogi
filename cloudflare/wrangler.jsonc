{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shogi-system",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ShogiRoom" },
      { "name": "DIRECTORY", "class_name": "ShogiDirectory" },
      { "name": "CONTENT", "class_name": "ShogiContent" }
    ]
  },
  "exports": {
    "ShogiRoom": { "type": "durable-object", "storage": "sqlite" },
    "ShogiDirectory": { "type": "durable-object", "storage": "sqlite" },
    "ShogiContent": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "APP_URL": "https://arunhistory.github.io/Shogi/",
    "APP_ORIGIN": "https://arunhistory.github.io"
  }
}
